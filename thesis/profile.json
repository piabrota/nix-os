  "layout": {
    "paper_mm": [
      210,
      297
    ],
    "paper_tolerance_mm": 1.5,
    "margin_min_mm": {
      "top": 25,
      "bottom": 25,
      "left": 30,
      "right": 30
    },
    "margin_tolerance_mm": 1.5,
    "body_font_pt": 12,
    "title_font_max_pt": 24,
    "single_baselineskip_pt": 14.5,
    "line_spacing": 1.5,
    "line_spacing_tolerance": 0.08,
    "font_families_ok": [
      "Termes",
      "QTM",
      "Times",
      "NimbusRoman",
      "Arial",
      "Helvetica",
      "Liberation"
    ],
    "bbox_footer_zone_pt": 60,
    "overfull_max_pt": 3,
    "margin_about": "margin_tolerance_mm covers poppler line boxes, which stand about 1.2 mm outside the glyphs; the exact text block comes from the TeX log."
  },
  "words": {
    "resumo_max": 250,
    "keywords_min": 3,
    "keywords_max": 6,
    "inline_quote_max_words": 40,
    "target_tolerance_low": 0.5,
    "target_tolerance_high": 1.6
  },
  "readability": {
    "sentence_mean_max": 28,
    "sentence_long_words": 40,
    "sentence_long_share_max": 0.08,
    "paragraph_words_max": 220,
    "one_sentence_paragraph_share_max": 0.25,
    "passive_share_max": 0.30,
    "flesch_pt_min": 25,
    "worst_sentences": 5,
    "min_sentences": 5,
    "anglicism_fail_distinct": 3,
    "long_sentence_warn_words": 60
  },
  "slop": {
    "threshold": 35,
    "min_words": 120,
    "min_sentences_for_cv": 8,
    "weights": {
      "phrases": 25,
      "dashes": 8,
      "tricolon": 7,
      "same_opening": 10,
      "low_variation": 10,
      "summary_endings": 8,
      "repeated_ngrams": 7,
      "hedging": 5,
      "bold_leadins": 5,
      "restated_heading": 5,
      "transitions": 10
    },
    "warn": {
      "phrases": 1.0,
      "dashes": 2.0,
      "tricolon": 0.06,
      "same_opening": 0,
      "low_variation": 0.50,
      "summary_endings": 0.15,
      "repeated_ngrams": 1.0,
      "hedging": 10.0,
      "bold_leadins": 1,
      "restated_heading": 0.5,
      "transitions": 0.20
    },
    "max": {
      "phrases": 8.0,
      "dashes": 12.0,
      "tricolon": 0.25,
      "same_opening": 3,
      "low_variation": 0.25,
      "summary_endings": 0.60,
      "repeated_ngrams": 6.0,
      "hedging": 30.0,
      "bold_leadins": 5,
      "restated_heading": 0.9,
      "transitions": 0.60
    },
    "ngram_size": 4,
    "ngram_min_repeats": 3,
    "same_opening_run": 3,
    "tricolon_item_max_words": 5,
    "about": "A signal scores weight * clamp((value - warn) / (max - warn), 0, 1). The score is the sum, from 0 (no surface pattern) to 100."
  },
